{
  "expo": {
    "name": "pet-tracker",
    "slug": "pet-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "es.mmdevs.pettracker",
      "infoPlist": {}
    },
    "android": {
      "package": "es.mmdevs.pettracker",
      "versionCode": 14,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f5f5f5",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121212"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PetTracker usa tu ubicación para registrar la ruta de los paseos y el lugar donde tu mascota hace sus necesidades."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PetTracker necesita acceder a tus fotos para poner una foto de perfil a tu mascota."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class androidx.work.** { *; }\n-keep class * extends androidx.room.RoomDatabase\n-keep @androidx.room.Database class * { *; }\n-dontwarn androidx.work.**"
          }
        }
      ]
    ],
    "extra": {
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "ea719472-3ab4-4e22-a16e-c722ff35af7e"
      }
    }
  }
}
